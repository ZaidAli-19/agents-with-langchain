# Copy this file to .env and fill in your values. Never commit .env.
APP_ENV=development
# Your own Gemini API key. Put the real key only in your untracked .env.
GEMINI_API_KEY=
# The default model is `gemini-3.5-flash-lite`; the instructor may supply another.
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
HOST=127.0.0.1
PORT=8000
